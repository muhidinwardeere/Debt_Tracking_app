rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each signed-in shop owner can only read and write their own records,
    // and only in the shapes the app uses. Limits match app.js (LIMITS).
    //
    // Protection against deleting: records are never removed straight away.
    // The app moves them to a recycle bin by setting deletedAt to the
    // server's time. Permanent deletion is refused until a record has been
    // in the bin for 30 days, and debt/payment records cannot be changed.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // The app owner's Google account(s): may read every shop's usage
    // counts (never customers or records). Same ids as DEYN_ADMINS in
    // firebase-config.js.
    function isAdmin() {
      return request.auth != null && request.auth.uid in ['Qk7eYuDz7FMAQLfJKbdoPTKsE3t2'];
    }
    // ---------- Membership ----------
    // members/{uid}: a free trial (30 days from startedAt, by the server's
    // clock), or monthly/yearly until a date, or lifetime. Only the admin
    // can give or change memberships; a user can only start their own
    // trial, once. Saving records needs an active membership; reading and
    // exporting your own records always works.
    function memberDoc(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isActive(uid) {
      return isAdmin() || (exists(memberDoc(uid)) && activePlan(get(memberDoc(uid)).data));
    }
    function activePlan(m) {
      return m.plan == 'lifetime'
        || (m.plan == 'trial' && m.startedAt is timestamp
            && request.time < m.startedAt + duration.value(30, 'd'))
        || ((m.plan == 'monthly' || m.plan == 'yearly') && m.until is timestamp
            && request.time < m.until);
    }

    function okId(id) {
      return id is string && id.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$');
    }
    function okText(data, field, max) {
      return !(field in data) || (data[field] is string && data[field].size() <= max);
    }
    // deletedAt, when present, must be exactly "now" by the server's clock
    // (or unchanged), so it cannot be backdated.
    function okDeletedAt() {
      return !('deletedAt' in request.resource.data)
        || request.resource.data.deletedAt == request.time
        || (resource != null && 'deletedAt' in resource.data
            && request.resource.data.deletedAt == resource.data.deletedAt);
    }
    function binnedLongEnough() {
      return 'deletedAt' in resource.data
        && resource.data.deletedAt is timestamp
        && resource.data.deletedAt < request.time - duration.value(30, 'd');
    }

    match /users/{uid}/customers/{id} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid) && binnedLongEnough();
      allow create, update: if isOwner(uid) && isActive(uid) && okId(id)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'place', 'createdAt', 'deletedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && okText(request.resource.data, 'phone', 30)
        && okText(request.resource.data, 'place', 200)
        && okText(request.resource.data, 'createdAt', 40)
        && okDeletedAt();
    }

    match /users/{uid}/entries/{id} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid) && binnedLongEnough();
      allow create: if isOwner(uid) && isActive(uid) && okId(id) && validEntry() && okDeletedAt();
      // A saved debt or payment can only be moved to / out of the bin.
      allow update: if isOwner(uid) && isActive(uid) && validEntry() && okDeletedAt()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedAt']);
    }
    function validEntry() {
      return request.resource.data.keys().hasOnly(['customerId', 'type', 'amount', 'note', 'date', 'createdAt', 'deletedAt'])
        && okId(request.resource.data.customerId)
        && request.resource.data.type in ['debt', 'payment']
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000000000
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && okText(request.resource.data, 'note', 300)
        && okText(request.resource.data, 'createdAt', 40);
    }

    match /users/{uid}/meta/settings {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isActive(uid)
        && request.resource.data.keys().hasOnly(['shopName', 'currency'])
        && okText(request.resource.data, 'shopName', 60)
        && okText(request.resource.data, 'currency', 8);
    }

    // Usage counts for the admin page: shop name, Google email, number of
    // customers and records, last time the app was opened. No customer
    // names, phone numbers or amounts.
    match /users/{uid}/stats/summary {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['shopName', 'customers', 'entries', 'lang', 'version', 'platform', 'lastOpen', 'firstSeen', 'email'])
        // The email must be the signed-in Google account's own email.
        && (!('email' in request.resource.data) || request.resource.data.email == ''
            || request.resource.data.email == request.auth.token.email)
        && okText(request.resource.data, 'shopName', 60)
        && request.resource.data.customers is int && request.resource.data.customers >= 0
        && request.resource.data.entries is int && request.resource.data.entries >= 0
        && okText(request.resource.data, 'lang', 5)
        && okText(request.resource.data, 'version', 10)
        && okText(request.resource.data, 'platform', 10)
        && request.resource.data.lastOpen == request.time
        && (resource == null
              ? request.resource.data.firstSeen == request.time
              : request.resource.data.firstSeen == resource.data.firstSeen);
    }
    match /members/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // A user may start their own free trial, once.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['plan', 'startedAt', 'email'])
        && request.resource.data.plan == 'trial'
        && request.resource.data.startedAt == request.time
        && (request.resource.data.email == '' || request.resource.data.email == request.auth.token.email);
      // Only the admin gives, extends or stops memberships.
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['plan', 'until', 'startedAt', 'email', 'updatedAt'])
        && request.resource.data.plan in ['trial', 'monthly', 'yearly', 'lifetime', 'stopped']
        && (request.resource.data.get('until', null) == null || request.resource.data.until is timestamp);
      allow delete: if isAdmin();
    }

    // The admin page reads all shops' counts at once.
    match /{path=**}/stats/{doc} {
      allow read: if isAdmin();
    }

    // Everything else is closed.
  }
}
