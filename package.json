{
  "name": "deyn-book",
  "private": true,
  "description": "Deyn Book: simple debt book for small shops",
  "scripts": {
    "build": "esbuild cloud/cloud.src.js --bundle --format=esm --minify --target=es2020 --outfile=cloud.bundle.js && esbuild cloud/excel.src.js --bundle --format=esm --minify --target=es2020 --outfile=excel.bundle.js",
    "emulators": "firebase emulators:start --only auth,firestore --project deyn-book"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "fflate": "^0.8.3",
    "firebase": "^12.19.0",
    "firebase-tools": "13.15.0",
    "xlsx": "^0.18.5"
  }
}
